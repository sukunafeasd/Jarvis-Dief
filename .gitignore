# Only public defaults, Python sources and identity assets belong in config.
/config/*
!/config/__init__.py
!/config/defaults.json
!/config/api_keys.example.json
!/config/dief-jarvis.ico
!/config/dief-jarvis.png
!/config/jarvis.ico

# Memory is local; only the modules are versioned.
/memory/*
!/memory/*.py

**/token*.json
**/token*.bin
**/token*.tmp
**/*credentials*.json
**/client_secret*.json
**/certs/
**/whatsapp_web/
**/.jarvis_profiles/
.env
.env.*
*.db
*.sqlite
*.sqlite3
*.sqlite3-*
*.db-*
*.pem
*.key
*.p12
*.pfx
*.lnk

__pycache__/
*.py[cod]
*$py.class
*.so
/build/
/dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
*.log
logs/
downloads/
screenshots/
/validation/*
!/validation/*.md
core/spatial/vendor/*.tgz
